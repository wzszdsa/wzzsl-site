# ============================================================
#  宠物预约 —— systemd 服务单元
#  部署位置：/etc/systemd/system/petcare.service
#
#  说明：sites/pet-care 是 Next.js 应用，需要常驻 Node 进程。
#        Nginx 将 petcare.wzzsl.fun 全量反代到本服务。
#
#  运行身份：与服务器上既有的 yijian.service 保持一致，均以 root 运行。
#        该机为单人管理、仅承载本人家族站点的场景，此选择可减少
#        文件属主与权限带来的故障面。若日后需要收紧，可改用专用用户
#        并把 /srv/wzzsl 整体 chown 过去。
# ============================================================

[Unit]
Description=宠物预约 Next.js 应用
Documentation=https://github.com/wzszdsa/wzzsl-site
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/srv/wzzsl/petcare

# 环境变量：DATABASE_URL（PostgreSQL）、OPENAI_API_KEY 等
EnvironmentFile=/srv/wzzsl/petcare/.env

Environment=NODE_ENV=production
Environment=PORT=3102
Environment=HOSTNAME=127.0.0.1
# 限制堆内存：本机仅 1.6 GB，需与 MariaDB / PostgreSQL / 驿见共存
Environment=NODE_OPTIONS=--max-old-space-size=320

# 直接调用 Next.js 二进制，避免依赖 npx / 全局包
ExecStart=/usr/bin/node /srv/wzzsl/petcare/node_modules/next/dist/bin/next start -p 3102 -H 127.0.0.1

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=petcare

[Install]
WantedBy=multi-user.target
