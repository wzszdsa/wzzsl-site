# ============================================================
#  部署配置示例
# ------------------------------------------------------------
#  用法：复制为 deploy/.env.deploy 并填写真实值。
#        该文件已被 .gitignore 排除，不会提交到仓库。
# ============================================================

# ---------- 服务器连接 ----------
SERVER_HOST=1.2.3.4
SERVER_USER=wzzsl
SERVER_PORT=22

# 私钥路径（留空则使用默认密钥或 ssh-agent）
SSH_KEY=~/.ssh/id_ed25519

# 服务器上的站点根目录
REMOTE_ROOT=/srv/wzzsl
