# Node 通过本机 HTTP 代理访问 Resend 时启用；没有代理可删除或改为 0。
NODE_USE_ENV_PROXY=1

VITE_API_BASE_URL=
# 仅开发环境启用 Vite-only 演示认证；生产构建不会启用演示登录。
VITE_ENABLE_DEMO_AUTH=true

# 本地开发不连接线上数据库，使用本地 JSON 记录。
STORAGE_PROVIDER=local

# 本地没有邮件服务密钥时，使用 console 演示模式。
EMAIL_PROVIDER=console
AUTH_EXPOSE_DEMO_CODE=true

# 真实部署到 Netlify + Supabase + Resend 时配置：
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://你的项目.supabase.co
# SUPABASE_SECRET=服务端 secret，只放在 Netlify Functions 环境变量中
# 也兼容 SUPABASE_SECRET_KEY 或 SUPABASE_SERVICE_ROLE_KEY
# EMAIL_PROVIDER=resend
# RESEND_TOKEN=只放在Netlify Functions环境变量中
# EMAIL_FROM=no-reply@wzzsl.cloud
# AUTH_EXPOSE_DEMO_CODE=false
