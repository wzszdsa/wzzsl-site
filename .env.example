# Node 通过本机 HTTP 代理访问 Resend 时启用；没有代理可删除或改为 0。
NODE_USE_ENV_PROXY=1

VITE_API_BASE_URL=
# 仅开发环境启用 Vite-only 演示认证；生产构建不会启用演示登录。
VITE_ENABLE_DEMO_AUTH=true

# 本地开发不连接线上数据库，使用本地 JSON 记录。
STORAGE_PROVIDER=local

# 本地没有邮件服务密钥时，使用 console 演示模式。
EMAIL_PROVIDER=console
AUTH_EXPOSE_DEMO_CODE=true

# 生产部署默认使用 Supabase；密钥只放在 Netlify Functions 环境变量中。
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://你的项目.supabase.co
# SUPABASE_SECRET_KEY=服务端 secret，只放在 Netlify Functions 环境变量中
# EMAIL_PROVIDER=resend
# RESEND_TOKEN=只放在Netlify环境变量中
# EMAIL_FROM=no-reply@wzzsl.cloud
# EMAIL_SUBJECT=驿见邮箱验证码
# AUTH_EXPOSE_DEMO_CODE=false
# 快递100服务端凭证；不要使用 VITE_ 前缀，不要提交到 Git。
# KUAIDI100_KEY=快递100授权key
# KUAIDI100_CUSTOMER=快递100customer编码
# KUAIDI100_TRACK_QUERY_URL=https://poll.kuaidi100.com/poll/query.do
# KUAIDI100_RECOGNIZE_URL=https://www.kuaidi100.com/autonumber/autoComNum
# 可选：开通快递100行政区域/坐标解析后设置，接口返回坐标时前端会展示地图轨迹。
# KUAIDI100_RESULTV2=5

# 可选：如果明确需要使用 MySQL，再改用以下配置。
# STORAGE_PROVIDER=mysql
# MYSQL_URL=mysql://用户名:密码@主机:3306/数据库名
# MYSQL_SSL=true
# MYSQL_CONNECTION_LIMIT=4
